      "emailVerified": true,
      "enabled": true,
      "firstName": "Yelisson",
      "lastName": "Ortiz",
      "credentials": [{ "type": "password", "value": "${RESOLVE_DEMO_USER_PASSWORD:demo}", "temporary": false }]
    },
    {
