{
  "realm": "resolve",
  "displayName": "Resolve (demostración pública)",
  "enabled": true,
  "loginTheme": "resolve",
  "internationalizationEnabled": true,
  "supportedLocales": ["es"],
  "defaultLocale": "es",
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "permanentLockout": false,
  "clients": [
    {
      "clientId": "resolve-api",
      "name": "Resolve API (BFF)",
      "description": "Cliente confidencial del backend de la demostración. Su secreto viene de RESOLVE_OIDC_CLIENT_SECRET.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${RESOLVE_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${RESOLVE_PUBLIC_URL}/api/login/oauth2/code/resolve"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${RESOLVE_PUBLIC_URL}##${RESOLVE_PUBLIC_URL}/"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
