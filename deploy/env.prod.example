# Variables de deploy/docker-compose.prod.yml. TODOS LOS VALORES SON FICTICIOS: sirven para probar la imagen en local y
# no deben usarse en ningún otro sitio. Copiar a deploy/.env.prod.local (ignorado por git) y pasarlo con --env-file.
DATABASE_USERNAME=resolve
DATABASE_PASSWORD=contrasena-ficticia-de-prueba
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-ficticia-de-prueba
RESOLVE_OIDC_CLIENT_SECRET=secreto-ficticio-de-prueba

# Puertos publicados en 127.0.0.1 (en un slot de Herdr: SERVER_PORT, POSTGRES_PORT y KEYCLOAK_PORT de .env.herdr).
SERVER_PORT=8080
POSTGRES_PORT=5432
KEYCLOAK_PORT=8180

# Datos de demostración (usuarios del realm de desarrollo: laura.mendez@acme.example, contraseña «demo», solo para
# esta prueba local: un despliegue usa RESOLVE_DEMO_USER_PASSWORD, ver docs/deploy/README.md). Sin esto la base empieza
# vacía y nadie tiene membresía.
# SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo

# Demostración pública: noindex, bandera «demo» en /me y modo mantenimiento (RESOLVE_DEMO_ENABLED) y topes por
# organización con límite de escrituras por IP (RESOLVE_DEMO_LIMITS). Ver docs/deploy/README.md.
# RESOLVE_DEMO_ENABLED=true
# RESOLVE_DEMO_LIMITS=true
