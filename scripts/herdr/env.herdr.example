# Example of the .env.herdr that scripts/herdr/new-task.sh writes at the root of each task worktree (slot 1).
# The file is ignored by git (.env.*). Load it in a shell with: set -a; . ./.env.herdr; set +a
HERDR_TASK_ID=t0-1-tickets-follow-ups
HERDR_TASK_SLOT=1
HERDR_TASK_BRANCH=fix/tickets-follow-ups
HERDR_TASK_WORKTREE=/home/you/resolver-herdr/worktrees/t0-1-tickets-follow-ups
HERDR_TASK_LOG_DIR=/home/you/resolver-herdr/logs/t0-1-tickets-follow-ups
DEV_SERVER_PORT=5181      # vite dev (frontend/vite.config.ts)
PLAYWRIGHT_PORT=4181      # vite preview started by Playwright (frontend/playwright.config.ts)
SERVER_PORT=8081          # Spring Boot
POSTGRES_PORT=5441        # docker-compose.yml host port
COMPOSE_PROJECT_NAME=resolve-t0-1-tickets-follow-ups
DATABASE_URL=jdbc:postgresql://localhost:5441/resolve
API_PROXY_TARGET=http://localhost:8081   # vite dev proxy for /api
