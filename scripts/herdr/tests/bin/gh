#!/usr/bin/env bash
# Fake gh for the scripts/herdr/ship.sh tests; it never talks to GitHub. State lives in $FAKE_STATE/gh, $FAKE_REMOTE is
# the bare "origin", every call is logged to calls.log. Knobs (files in $FAKE_STATE/gh):
#   checks   pass | fail | absent | pending:N (N polls pending, then pass) | multi (an older failed run, a newer passed one)
#            | queued (an older passed run and a rerun that has not started, with Go's zero time) | queued-null (same, startedAt null)
#            | requeue:N (N polls like queued, then pass)
#   merge    (absent) | never (the PR stays OPEN after the auto-merge is scheduled) | closed (it ends CLOSED, unmerged)
#   base     the base branch the PR reports (default main)
#   merge-commit  the merge commit the PR reports instead of main's tip (a commit that is not on origin/main)
#   view-jq       a jq filter applied to the JSON of a MERGED pull request (null, empty or missing fields, a merge commit
#                 that is not a SHA)
#   late-commit   (a worktree path) `pr merge` makes a commit in that worktree after the merge was requested, so the local
#            branch is ahead of the head that was merged
#   stale    N: `pr view --json headRefOid` shows an old head for the first N polls
set -euo pipefail
G=${FAKE_STATE:?}/gh; mkdir -p "$G"
echo "gh $*" >>"$G/calls.log"; echo "gh $*" >>"$FAKE_STATE/events.log"
cmd="$1 $2"; shift 2
jqopt() { local a; while [ $# -gt 0 ]; do [ "$1" = "--jq" ] && { printf '%s' "$2"; return; }; shift; done; }
emit() { local f; f=$(jqopt "$@"); if [ -n "$f" ]; then jq -r "$f"; else cat; fi; }
has() { local w=$1; shift; for a in "$@"; do [ "$a" = "$w" ] && return 0; done; return 1; }
case $cmd in
  "pr list")
    if [ -f "$G/pr.json" ] && [ "$(jq -r .state "$G/pr.json")" = OPEN ]; then jq -c '[{number:.number}]' "$G/pr.json"; else echo '[]'; fi | emit "$@" ;;
  "pr create")
    head=; while [ $# -gt 0 ]; do [ "$1" = "--head" ] && head=$2; shift; done
    jq -n --arg h "$head" '{number:41,head:$h,state:"OPEN"}' >"$G/pr.json"; echo "https://github.com/example/resolve/pull/41" ;;
  "pr checks")
    mode=$(cat "$G/checks" 2>/dev/null || echo pass); bucket=$mode; rc=0
    case $mode in
      requeue:*) rc=8 ;;
      pending:*) n=${mode#pending:}; c=$(cat "$G/polls" 2>/dev/null || echo 0); echo $((c + 1)) >"$G/polls"
        if [ "$c" -lt "$n" ]; then bucket=pending; rc=8; else bucket=pass; fi ;;
      absent) rc=1 ;;
      fail) rc=1 ;;
    esac
    if has --json "$@"; then
      case $mode in
        absent) echo '[{"name":"Other","bucket":"pass","startedAt":"2026-01-01T00:00:00Z"}]' ;;
        queued) echo '[{"name":"Full-stack smoke","bucket":"pass","startedAt":"2026-01-01T00:00:00Z"},{"name":"Full-stack smoke","bucket":"pending","startedAt":"0001-01-01T00:00:00Z"}]' ;;
        queued-null) echo '[{"name":"Full-stack smoke","bucket":"pass","startedAt":"2026-01-01T00:00:00Z"},{"name":"Full-stack smoke","bucket":"pending","startedAt":null}]' ;;
        requeue:*) n=${mode#requeue:}; c=$(cat "$G/polls" 2>/dev/null || echo 0); echo $((c + 1)) >"$G/polls"
          if [ "$c" -lt "$n" ]; then echo '[{"name":"Full-stack smoke","bucket":"pass","startedAt":"2026-01-01T00:00:00Z"},{"name":"Full-stack smoke","bucket":"pending","startedAt":null}]'
          else echo '[{"name":"Full-stack smoke","bucket":"pass","startedAt":"2026-01-01T00:00:00Z"},{"name":"Full-stack smoke","bucket":"pass","startedAt":"2026-01-01T02:00:00Z"}]'; fi ;;
        multi) echo '[{"name":"Full-stack smoke","bucket":"fail","startedAt":"2026-01-01T00:00:00Z"},{"name":"Full-stack smoke","bucket":"pass","startedAt":"2026-01-01T01:00:00Z"}]' ;;
        *) jq -n --arg b "$bucket" '[{name:"Full-stack smoke",bucket:$b,startedAt:"2026-01-01T00:00:00Z"},{name:"Other",bucket:"pass",startedAt:"2026-01-01T00:00:00Z"}]' ;;
      esac
    else printf 'Full-stack smoke\t%s\n' "$bucket"; fi
    exit "$rc" ;;
  # Scheduling the auto-merge is what merges (like GitHub, once the required checks pass); `pr view` only reports.
  "pr merge") : >"$G/auto"
    method=ff subject= body=; while [ $# -gt 0 ]; do
      case $1 in --squash) method=squash ;; --subject) subject=$2 ;; --body) body=$2 ;; esac; shift
    done
    if [ "$(cat "$G/merge" 2>/dev/null || echo merged)" = merged ]; then
      tip=$(git --git-dir "${FAKE_REMOTE:?}" rev-parse "refs/heads/$(jq -r .head "$G/pr.json")")
      # Like GitHub: a squash is one new commit on main with the branch's tree and the message the caller gave (the series
      # becomes one patch, so `git cherry` and `git branch -d` cannot see it as merged); a rebase merge keeps the commits.
      if [ "$method" = squash ]; then
        tip=$(GIT_COMMITTER_NAME=GitHub GIT_COMMITTER_EMAIL=noreply@github.com git --git-dir "$FAKE_REMOTE" commit-tree \
          -p refs/heads/main -m "$subject"$'\n\n'"$body" "$tip^{tree}")
      fi
      git --git-dir "$FAKE_REMOTE" update-ref refs/heads/main "$tip"
    fi
    if [ -f "$G/late-commit" ]; then
      echo late >"$(cat "$G/late-commit")/late.txt"; git -C "$(cat "$G/late-commit")" add late.txt
      git -C "$(cat "$G/late-commit")" -c user.name=t -c user.email=t@x commit -q -m "feat: late"
    fi ;;
  "pr view")
    head=$(jq -r .head "$G/pr.json")
    if has headRefOid "$@"; then
      n=$(cat "$G/stale" 2>/dev/null || echo 0)
      if [ "$n" -gt 0 ]; then echo $((n - 1)) >"$G/stale"; echo 0000000000000000000000000000000000000000
      else git --git-dir "${FAKE_REMOTE:?}" rev-parse "refs/heads/$head"; fi
    else
      h=$(git --git-dir "${FAKE_REMOTE:?}" rev-parse "refs/heads/$head"); b=$(cat "$G/base" 2>/dev/null || echo main)
      if [ -f "$G/auto" ] && [ "$(cat "$G/merge" 2>/dev/null || echo merged)" = merged ]; then
        jq -n --arg s "$(cat "$G/merge-commit" 2>/dev/null || git --git-dir "$FAKE_REMOTE" rev-parse refs/heads/main)" --arg h "$h" --arg b "$b" '{state:"MERGED",mergeCommit:{oid:$s},headRefOid:$h,baseRefName:$b}' | jq -c "$(cat "$G/view-jq" 2>/dev/null || echo .)" | emit "$@"
      elif [ -f "$G/auto" ] && [ "$(cat "$G/merge")" = closed ]; then jq -n --arg h "$h" --arg b "$b" '{state:"CLOSED",mergeCommit:null,headRefOid:$h,baseRefName:$b}' | emit "$@"
      else jq -n --arg h "$h" --arg b "$b" '{state:"OPEN",mergeCommit:null,headRefOid:$h,baseRefName:$b}' | emit "$@"; fi
    fi ;;
  *) echo "fake gh: unsupported $cmd" >&2; exit 2 ;;
esac
